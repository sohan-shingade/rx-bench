# Copy to .env and fill in what you need. Key NAMES only — never commit values.
# tau2 loads .env automatically (python-dotenv) on import.

# --- Model providers (via LiteLLM; set the ones your --agent-llm/--user-llm use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# --- Voice / audio (optional; [voice] extra)
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# --- tau2 knobs surfaced by rx_bench (see rx_bench/__init__.py)
# NL-assertion judge model (defaults to an OpenAI model — point it at whatever
# provider the rest of your run uses, or grading dies on a missing key AFTER
# the simulation tokens are spent).
TAU2_LLM_NL_ASSERTIONS=
# Env-interface model (used by some tau2 environments).
TAU2_LLM_ENV_INTERFACE=
# Retry knobs. TAU2_MAX_RETRIES (litellm, inner) and TAU2_RETRY_ATTEMPTS
# (tenacity, outer) MULTIPLY — keep the inner one small.
TAU2_MAX_RETRIES=
TAU2_RETRY_ATTEMPTS=
TAU2_RETRY_MIN_WAIT=
TAU2_RETRY_MAX_WAIT=
TAU2_RETRY_MULTIPLIER=

# --- Data locations (optional overrides)
# Directory containing db.json/policy.md/tasks.json/cases/mutants
# (defaults to <repo>/data/v1)
RX_BENCH_DATA_DIR=
# tau2 data root; simulations are written to $TAU2_DATA_DIR/simulations
# (defaults to <repo>/data)
TAU2_DATA_DIR=

# --- Medplum FHIR mirroring (optional; writes spool locally when unset)
MEDPLUM_BASE_URL=
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Set to 1 to disable Medplum POSTs even when credentials are present
MEDPLUM_DISABLE=
