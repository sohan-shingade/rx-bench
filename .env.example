# Copy to .env and fill in only what you need. Never commit secret values.
# rx-bench and tau2 load .env automatically.

# --- Model providers (via LiteLLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Text/telephony voice pipeline (optional; [voice] extra)
DEEPGRAM_API_KEY=
# AGENT_LLM=anthropic/claude-sonnet-4-5
# USER_LLM=anthropic/claude-sonnet-4-5
# DEEPGRAM_MODEL=nova-3-medical
# WHISPER_MODEL=small.en
# MAX_STEPS=40

# --- Audio-native voice runner (optional; [voice] extra)
# PROVIDER=openai                  # openai | gemini | xai | livekit
# MODEL=
# MAX_SECONDS=600
# CONCURRENCY=1
# SEED=42
# Use Deepgram Aura-2 instead of the default ElevenLabs caller TTS.
# TAU2_TTS_PROVIDER=deepgram       # deepgram | elevenlabs
# TAU2_DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Override tau2's OpenAI turn-taking model when needed.
# TAU2_VOICE_USER_LLM=anthropic/claude-sonnet-4-5
ELEVENLABS_API_KEY=
# ElevenLabs mode needs voice IDs for the selected speech complexity.
# TAU2_VOICE_ID_MATT_DELANEY=
# TAU2_VOICE_ID_LISA_BRENNER=
# TAU2_VOICE_ID_MILDRED_KAPLAN=
# TAU2_VOICE_ID_ARJUN_ROY=
# TAU2_VOICE_ID_WEI_LIN=
# TAU2_VOICE_ID_MAMADOU_DIALLO=
# TAU2_VOICE_ID_PRIYA_PATIL=
# TAU2_ALLOW_DEFAULT_VOICES=1

# --- tau2 knobs surfaced by rx_bench (see rx_bench/__init__.py)
# Point the judge at a model for which you configured credentials. Blank or
# unset values retain tau2's defaults.
# TAU2_LLM_NL_ASSERTIONS=anthropic/claude-sonnet-4-5
# TAU2_LLM_ENV_INTERFACE=anthropic/claude-sonnet-4-5
# Inner LiteLLM retries and outer tenacity attempts multiply.
# TAU2_MAX_RETRIES=1
# TAU2_RETRY_ATTEMPTS=3
# TAU2_RETRY_MIN_WAIT=1
# TAU2_RETRY_MAX_WAIT=10
# TAU2_RETRY_MULTIPLIER=1

# --- Data locations (optional overrides)
# RX_BENCH_DATA_DIR=/path/to/data/v1
# TAU2_DATA_DIR=/path/to/data
# TAU2_ROOT=/path/to/tau2/checkout

# --- Medplum FHIR mirroring (optional; writes spool locally when unset)
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# MEDPLUM_DISABLE=1
